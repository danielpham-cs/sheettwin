# Language model for the chat (optional). Copy this file to .env and fill it in:
#   cp .env.example .env
# .env is git-ignored. Without a model the chat answers with the built-in rules.
# Every other setting lives in config/settings.yaml; the variables below override its `llm` block.
# Settings are read from the environment first, then from .env in the directory `sheetir serve` runs in.
#
# What is sent to the model: a compact sketch of the parsed workbook (sheets, tables with a few sample rows,
# parameters, issues), the question, and the rows of the read-only queries SheetIR runs for it. Never the file itself.
# Every call is also logged locally to .logs/llm.jsonl (git-ignored; turn off with llm.log in settings.yaml).

# Any OpenAI-compatible Chat Completions endpoint. Setting it turns the model on.
#   Ollama (this machine or another on the LAN; start it with OLLAMA_HOST=0.0.0.0 to accept LAN connections and
#   OLLAMA_CONTEXT_LENGTH=32768, since its default context is short and long prompts are cut without an error;
#   also set SHEETIR_LLM_THINKING_PARAM=think below):
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   vLLM / llama.cpp / OpenVINO server:  OPENAI_BASE_URL=http://127.0.0.1:8000/v1
#   From Docker, a server on the host:   OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# Optional for local servers. Required by cloud APIs.
OPENAI_API_KEY=

# Model name as the endpoint knows it (`ollama list`).
SHEETIR_LLM_MODEL=qwen3:30b-a3b

# How thinking is switched off: think for Ollama; leave unset (auto) for llama.cpp, vLLM and OpenAI.
# SHEETIR_LLM_THINKING_PARAM=think

# SheetTwin runs offline: an endpoint outside this machine and the local network is refused, since workbook contents
# would leave it. To use a cloud API anyway (for example OpenAI, OPENAI_BASE_URL=https://api.openai.com/v1):
# SHEETIR_ALLOW_REMOTE_LLM=1
