# Language model for the chat (optional). Copy this file to .env and fill it in:
#   cp .env.example .env
# .env is git-ignored. Without OPENAI_API_KEY the chat answers with the built-in rules.
# Settings are read from the environment first, then from .env in the directory `sheetir serve` runs in.
#
# What is sent to the model: a compact sketch of the parsed workbook (sheets, tables with a few sample rows,
# parameters, issues), the question, and the rows of the read-only queries SheetIR runs for it. Never the file itself.
# With a cloud endpoint, that content leaves this machine; use a local server for confidential workbooks.

# Any OpenAI-compatible Chat Completions endpoint. Default: https://api.openai.com/v1
#   Ollama (this machine or another on the LAN; start it with OLLAMA_HOST=0.0.0.0 to accept LAN connections and
#   OLLAMA_CONTEXT_LENGTH=32768, since its default context is short and long prompts are cut without an error):
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
#   vLLM / llama.cpp server:  OPENAI_BASE_URL=http://127.0.0.1:8000/v1
#   OpenAI:                   OPENAI_BASE_URL=https://api.openai.com/v1

# Required to turn the model on. Local servers such as Ollama ignore it, but it must not be empty.
OPENAI_API_KEY=ollama

# Model name as the endpoint knows it (`ollama list`). Default: gpt-5.4-mini
SHEETIR_LLM_MODEL=qwen3:30b-a3b
